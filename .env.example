# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Every variable below is validated at boot by
# `src/lib/env.ts` (@t3-oss/env-nextjs) — the app refuses to start if a
# required one is missing or malformed.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development

# Public origin of the app. Used for auth callbacks and e-mail links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (matches docker-compose.yml defaults) ------------------------
DATABASE_URL=postgres://admin:admin@localhost:5432/modern_admin

# Max connections in the pg pool.
DATABASE_POOL_MAX=10

# --- Redis -----------------------------------------------------------------
# Optional. When unset the app runs with an in-memory cache fallback, which is
# fine for a single-process dev server but NOT for production.
REDIS_URL=redis://localhost:6379

# --- Better-Auth -----------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000

# --- OAuth providers (optional) --------------------------------------------
# A provider is only registered when BOTH of its variables are present.
# Google:  https://console.cloud.google.com/apis/credentials
#          callback: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub:  https://github.com/settings/developers
#          callback: {NEXT_PUBLIC_APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Mail ------------------------------------------------------------------
# `console` prints verification / reset links to the server log (dev default).
# `resend` sends through the Resend HTTP API and requires RESEND_API_KEY.
MAIL_TRANSPORT=console
MAIL_FROM="Modern Admin <no-reply@example.com>"
RESEND_API_KEY=

# --- Audit log -------------------------------------------------------------
# Entries older than this are removed by `purgeExpiredAuditLogs()`.
AUDIT_LOG_RETENTION_DAYS=90

# --- Observability ---------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Seed ------------------------------------------------------------------
# Credentials for the super-admin created by `pnpm db:seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Super Admin
